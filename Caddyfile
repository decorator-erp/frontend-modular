# DEP-1: serves PERA's Angular build and proxies the API on the same address, so the app's
# same-origin /api and /hubs calls need no CORS.
#
# This container publishes no port. The VPS's shared edge Caddy (the only one on 80/443, which also
# terminates HTTPS once a domain is added) reaches it as pera-web:80 over the `edge` Docker network.
{
	# Keep the edge's X-Forwarded-For/-Proto: only Docker's private networks can reach this server.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# The API: REST, the SignalR hub (WebSockets pass through) and the health probe.
	@api path /api/* /hubs/* /health
	handle @api {
		request_body {
			# Uploads go up to FileStorage:MaxUploadBytes (50 MB) plus multipart overhead.
			max_size 55MB
		}
		reverse_proxy api:8080 {
			# Hand the API exactly one X-Forwarded-For entry: the real client, as resolved through the
			# trusted edge. Appending the edge's own address would make every caller look like the edge
			# to the API (it uses only the last entry, ForwardLimit 1) and share one rate-limit bucket.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Hashed bundles never change: cache for a year. index.html must always be fresh.
		@hashed path_regexp \.[0-9a-zA-Z]{8,}\.(js|css|woff2?|ttf|svg|png|jpg|webp)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-cache"
		# Single-page app: unknown paths load index.html and the Angular router takes over.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
